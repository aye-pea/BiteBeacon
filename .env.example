# Copy to .env and fill in from your Supabase project settings.
# These are public client values. Never put a service-role key, secret key,
# database password or SMTP credential here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Free USDA FoodData Central key (https://fdc.nal.usda.gov/api-key-signup). Public rate-limit id.
EXPO_PUBLIC_USDA_FDC_API_KEY=
